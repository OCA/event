msgstr "%(name)s ist von der Warteliste nachgerückt und jetzt angemeldet (%(seats)s Platz/Plätze)."

#. module: event_waitlist
#: model:mail.template,body_html:event_waitlist.mail_template_waitlist_joined
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hello <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        <t t-out=\"object.event_id.name or ''\">Yoga Basics</t> is fully booked at the moment.\n"
"        You are number <strong t-out=\"object.position or ''\">3</strong> on the waiting list\n"
"        (<t t-out=\"object.seats or ''\">1</t> seat(s)).\n"
"    </p>\n"
"    <p>\n"
"        As soon as a seat becomes free, we will email you.\n"
"    </p>\n"
"    <p style=\"margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url()\" style=\"background-color: #875A7B; padding: 8px 16px; color: #fff; text-decoration: none; border-radius: 5px;\">View my waiting list entry</a>\n"
"    </p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        No longer interested? <a t-att-href=\"object._get_portal_url('leave')\">Leave the waiting list</a>.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hallo <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        <t t-out=\"object.event_id.name or ''\">Yoga für Einsteiger</t> ist im Moment ausgebucht.\n"
"        Du stehst auf Platz <strong t-out=\"object.position or ''\">3</strong> der Warteliste\n"
"        (<t t-out=\"object.seats or ''\">1</t> Platz/Plätze).\n"
"    </p>\n"
"    <p>\n"
"        Sobald ein Platz frei wird, bekommst du eine E-Mail von uns.\n"
"    </p>\n"
"    <p style=\"margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url()\" style=\"background-color: #875A7B; padding: 8px 16px; color: #fff; text-decoration: none; border-radius: 5px;\">Meinen Eintrag ansehen</a>\n"
"    </p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        Kein Interesse mehr? <a t-att-href=\"object._get_portal_url('leave')\">Von der Warteliste austragen</a>.\n"
"    </p>\n"
"</div>\n"
"            "

#. module: event_waitlist
#: model:mail.template,body_html:event_waitlist.mail_template_waitlist_offer
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hello <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        good news: a seat for <strong t-out=\"object.event_id.name or ''\">Yoga Basics</strong> is free for you\n"
"        (<t t-out=\"object.seats or ''\">1</t> seat(s)).\n"
"    </p>\n"
"    <p>\n"
"        The seat is reserved for you until\n"
"        <strong t-out=\"object.offer_deadline\" t-options=\"{'widget': 'datetime', 'tz_name': object.event_id.date_tz}\">01/01/2026 18:00</strong>.\n"
"        Please confirm it before then, otherwise it will go to the next person.\n"
"    </p>\n"
"    <p style=\"margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url('accept')\" style=\"background-color: #875A7B; padding: 8px 16px; color: #fff; text-decoration: none; border-radius: 5px;\">Yes, I take the seat</a>\n"
"        <a t-att-href=\"object._get_portal_url('decline')\" style=\"margin-left: 12px; color: #875A7B;\">No, give it to the next person</a>\n"
"    </p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        No longer interested? <a t-att-href=\"object._get_portal_url('leave')\">Leave the waiting list</a>.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hallo <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        gute Nachricht: Für <strong t-out=\"object.event_id.name or ''\">Yoga für Einsteiger</strong> ist ein Platz für dich frei\n"
"        (<t t-out=\"object.seats or ''\">1</t> Platz/Plätze).\n"
"    </p>\n"
"    <p>\n"
"        Der Platz ist für dich reserviert bis\n"
"        <strong t-out=\"object.offer_deadline\" t-options=\"{'widget': 'datetime', 'tz_name': object.event_id.date_tz}\">01.01.2026 18:00</strong>.\n"
"        Bitte bestätige ihn bis dahin, sonst geht er an die nächste Person.\n"
"    </p>\n"
"    <p style=\"margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url('accept')\" style=\"background-color: #875A7B; padding: 8px 16px; color: #fff; text-decoration: none; border-radius: 5px;\">Ja, ich nehme den Platz</a>\n"
"        <a t-att-href=\"object._get_portal_url('decline')\" style=\"margin-left: 12px; color: #875A7B;\">Nein, gib ihn der nächsten Person</a>\n"
"    </p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        Kein Interesse mehr? <a t-att-href=\"object._get_portal_url('leave')\">Von der Warteliste austragen</a>.\n"
"    </p>\n"
"</div>\n"
"            "

#. module: event_waitlist
#: model:mail.template,body_html:event_waitlist.mail_template_waitlist_expired
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hello <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        unfortunately you did not confirm the offered seat for\n"
"        <strong t-out=\"object.event_id.name or ''\">Yoga Basics</strong> in time,\n"
"        so it went to the next person on the waiting list.\n"
"    </p>\n"
"    <p>We hope to see you at another event soon.</p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url()\">View my entry</a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hallo <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        leider hast du den angebotenen Platz für\n"
"        <strong t-out=\"object.event_id.name or ''\">Yoga für Einsteiger</strong> nicht rechtzeitig bestätigt,\n"
"        deshalb ging er an die nächste Person auf der Warteliste.\n"
"    </p>\n"
"    <p>Wir hoffen, dich bald bei einer anderen Veranstaltung zu sehen.</p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url()\">Meinen Eintrag ansehen</a>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: event_waitlist
#: model:mail.template,body_html:event_waitlist.mail_template_waitlist_confirmed
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hello <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        you moved up from the waiting list and are now registered for\n"
"        <strong t-out=\"object.event_id.name or ''\">Yoga Basics</strong>\n"
"        (<t t-out=\"object.seats or ''\">1</t> seat(s)).\n"
"    </p>\n"
"    <p t-if=\"object.event_id.date_begin\">\n"
"        Start:\n"
"        <t t-out=\"object.event_id.date_begin\" t-options=\"{'widget': 'datetime', 'tz_name': object.event_id.date_tz}\">01/01/2026 18:00</t>\n"
"        <t t-if=\"object.event_id.address_id\">,\n"
"            <t t-out=\"object.event_id.address_id.display_name or ''\">Studio</t>\n"
"        </t>\n"
"    </p>\n"
"    <p>See you there!</p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url()\">View my entry</a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hallo <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"    <p>\n"
"        du bist von der Warteliste nachgerückt und jetzt angemeldet für\n"
"        <strong t-out=\"object.event_id.name or ''\">Yoga für Einsteiger</strong>\n"
"        (<t t-out=\"object.seats or ''\">1</t> Platz/Plätze).\n"
"    </p>\n"
"    <p t-if=\"object.event_id.date_begin\">\n"
"        Beginn:\n"
"        <t t-out=\"object.event_id.date_begin\" t-options=\"{'widget': 'datetime', 'tz_name': object.event_id.date_tz}\">01.01.2026 18:00</t>\n"
"        <t t-if=\"object.event_id.address_id\">,\n"
"            <t t-out=\"object.event_id.address_id.display_name or ''\">Studio</t>\n"
"        </t>\n"
"    </p>\n"
"    <p>Bis bald!</p>\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        <a t-att-href=\"object._get_portal_url()\">Meinen Eintrag ansehen</a>\n"
"    </p>\n"
"</div>\n"
"            "


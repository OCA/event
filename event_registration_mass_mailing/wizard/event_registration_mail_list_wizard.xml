<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="event_registration_mail_list_wizard_form" model="ir.ui.view">
        <field name="model">event.registration.mail.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Create contact mailing list">
                <group>
                    <field name="mail_list" />
                </group>
                <footer>
                    <button
                        string="Create contacts"
                        name="add_to_mail_list"
                        type="object"
                        class="oe_highlight"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>

<odoo>
    <record model="ir.ui.view" id="event_event_view_form">
        <field name="model">event.event</field>
        <field name="inherit_id" ref="website_event.event_event_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='question_ids']/list/field[@name='answer_ids']"
                position="after"
            >
                <field name="restricted_ticket_ids" widget="many2many_tags" />
            </xpath>
            <field name="question_ids" position="attributes">
                <attribute
                    name="context"
                >{'list_view_ref': 'event.event_question_view_list_add', 'form_view_ref': 'website_event_questions_by_ticket.event_question_view_form'}</attribute>
            </field>
        </field>
    </record>
</odoo>

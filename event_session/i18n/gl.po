#. module: event_session
#: model:mail.template,body_html:event_session.event_session_registration_mail_template_badge
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.name or ''\">Oscar Morgan</t>,<br>\n"
"    Thank you for your inquiry.<br>\n"
"    Here is your badge for the event <t t-out=\"object.session_id.name or ''\">OpenWood Collection Online Reveal</t>.<br>\n"
"    If you have any questions, please let us know.\n"
"    <br><br>\n"
"    Thank you,\n"
"    <t t-if=\"object.session_id.user_id.signature\">\n"
"        <br>\n"
"        <t t-out=\"object.session_id.user_id.signature or ''\">--<br>Mitchell Admin</t>\n"
"    </t>\n"
"</div>"
msgstr ""
"<div>\n"
"    Estimado <t t-out=\"objeto.nombre o ''\">Óscar Morgan</t>,<br>\n"
"    Grazas pola súa consulta.<br>\n"
"    Aquí está a súa insignia para o evento <t t-out=\"object.session_id.name "
"or ''\">OpenWood Collection En liña Reveal</t>.<br>\n"
"    Se ten algunha dúbida, por favor póñase en contacto connosco.\n"
"    <br><br>\n"
"    Grazas,\n"
"    <t t-if=\"objeto.sesión_id.usuario_id.firma\">\n"
"        <br>\n"
"        <t t-out=\"object.session_id.user_id.signature or ''\">--<br>"
"Mitchell Admin</t>\n"
"    </t>\n"
"</div>"


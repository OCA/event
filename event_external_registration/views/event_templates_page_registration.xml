<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="registration_template_external_link"
        inherit_id="website_event.registration_template"
    >
        <xpath
            expr="//button[@data-bs-target='#modal_ticket_registration']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not event.external_link_url and event.event_registrations_open</attribute>
        </xpath>

        <xpath
            expr="//button[@data-bs-target='#modal_ticket_registration']"
            position="after"
        >
            <a
                t-if="event.external_link_url"
                t-att-href="event.external_link_url"
                t-attf-class="btn btn-primary {{cta_additional_classes}}"
                target="_blank"
                rel="noopener noreferrer"
            >
            Register
        </a>
        </xpath>
    </template>
</odoo>
